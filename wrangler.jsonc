{
  "name": "vitaharbor",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vitaharbor",
      "database_id": "vitaharbor-db-id",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *", "0 3 * * *"]
  },
  "observability": { "enabled": true },
  "keep_vars": true,
  "env": {
    "staging": {
      "name": "vitaharbor-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vitaharbor-staging",
          "database_id": "vitaharbor-staging-db-id",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
