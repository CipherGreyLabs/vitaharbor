{
  "name": "vitaharbor",
  "version": "0.1.0",
  "private": true,
  "description": "Production-quality PS Vita port-development tracker. Unofficial community project. Not affiliated with Sony Interactive Entertainment.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build && tsx scripts/prerender.mjs",
    "preview": "vite preview",
    "preview:worker": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "tunnel": "localtunnel --port 8787 --subdomain vitaharbor",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "assets:og": "node scripts/make-og.mjs",
    "assets:sitemap": "node scripts/make-sitemap.mjs",
    "data:scan": "node scripts/cron-reddit-scan.mjs",
    "data:list": "node scripts/promote-candidate.mjs --list",
    "data:promote": "node scripts/promote-candidate.mjs",
    "data:feeds": "tsx scripts/make-feeds.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "reddit:backfill": "tsx scripts/reddit-backfill.ts",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy": "wrangler deploy --env production",
    "build:prerender": "tsx scripts/prerender.mjs"
  },
  "dependencies": {
    "@studio-freight/lenis": "^1.0.42",
    "@types/three": "^0.186.0",
    "clsx": "^2.1.1",
    "hono": "^4.7.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "tailwind-merge": "^3.0.2",
    "three": "^0.186.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "jsdom": "^26.0.0",
    "playwright": "^1.50.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wrangler": "^3.109.2"
  }
}
